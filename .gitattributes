# Line endings are the repository's, not each machine's core.autocrlf (job-hunt AB#2249, T-048). Text is stored and
# checked out as LF on every machine, so a tool that writes LF leaves nothing for git to report.
* text=auto eol=lf

# Windows scripts the Board runs keep CRLF in the working copy.
*.ps1 text eol=crlf

# Binary: never converted, never diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary
*.flp binary
*.als binary
*.wav binary
*.flac binary
*.mp3 binary
*.ogg binary
