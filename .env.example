# beatbranch settings (README.md, "Settings"). Copy to DATA_DIR/.env or set in the environment. Never commit a real one.
# DATABASE_URL is a secret: postgres://user:password@host:5432/beatbranch?sslmode=verify-full (TLS is required off localhost)
DATABASE_URL=
# HOST=127.0.0.1
# PORT=4420
# PUBLIC_URL=http://127.0.0.1:4420
# DATA_DIR=            (default: %LOCALAPPDATA%/beatbranch)
# BLOB_STORE=disk      (or azure, with AZURE_STORAGE_ACCOUNT and AZURE_BLOB_CONTAINER)
# STORAGE_QUOTA_BYTES=2147483648
# SIGNUP=open          (or closed)
# LOG_LEVEL=info
